<Window x:Class="Lab2_TicTacToe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Хрестики-нулики" Height="520" Width="450">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Хрестики-нулики" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding Result}" FontSize="18" HorizontalAlignment="Center" Margin="0,10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Рівень: " VerticalAlignment="Center"/>
                <ComboBox Width="130" SelectedValue="{Binding Level}">
                    <ComboBoxItem Content="1 - легкий" Tag="1"/>
                    <ComboBoxItem Content="2 - середній" Tag="2"/>
                    <ComboBoxItem Content="3 - складний" Tag="3"/>
                </ComboBox>
            </StackPanel>
        </StackPanel>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Cells}" Margin="20">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="3" Columns="3"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding Value}"
                            FontSize="40"
                            Command="{Binding DataContext.MakeMoveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding Index}"
                            Margin="3"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Grid.Row="2" Content="Нова гра"
                Command="{Binding NewGameCommand}"
                Width="120" Height="35" HorizontalAlignment="Center"/>
    </Grid>
</Window>
